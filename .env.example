# Imalissa — environment template. Copy to .env and fill in real values.
# NEVER commit the real .env (it is git-ignored).

# ── Database (MySQL) ────────────────────────────────────────────────
DATABASE_URL="mysql://user:password@HOST:3306/imalissa?sslmode=require"

# ── Site ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Imalissa"

# ── Auth / admin bootstrap ──────────────────────────────────────────
AUTH_SECRET="change-me-to-a-long-random-string"
ADMIN_EMAIL="admin@imalissa.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Imalissa Admin"

# ── Partner (DropSource BD) commerce API ────────────────────────────
EXTERNAL_COMMERCE_MODE="live"
EXTERNAL_COMMERCE_BASE_URL="https://dropsourcebd.com/api/dropship/v1"
EXTERNAL_COMMERCE_API_KEY=""
EXTERNAL_COMMERCE_API_SECRET=""
EXTERNAL_COMMERCE_TIMEOUT_MS="15000"

# ── Payment gateways (leave empty until you have real credentials) ──
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_BASE_URL=""
NAGAD_MERCHANT_ID=""
NAGAD_PRIVATE_KEY=""
NAGAD_PUBLIC_KEY=""

# ── SMTP (order/OTP/reset emails) ───────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
OTP_DEV_MODE="false"

# ── Telegram order alerts (bot token from @BotFather — never in DB) ──
TELEGRAM_BOT_TOKEN=""
