// ============================================================
// Imalissa — Prisma schema (MySQL / MariaDB)
// Multi-category e-commerce reseller platform with external
// order-forwarding (boss's e-commerce API) integration.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  FAILED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  CARD
  OTHER
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  FAILED
}

// External API synchronization status of an order.
// SYNC_TIMEOUT = request was sent but the response never arrived
// (the external system *may* have created the order — requires
// verification before any retry to avoid duplicates).
enum ExternalSyncStatus {
  NOT_CONFIGURED
  PENDING
  SYNCING
  SYNCED
  FAILED
  SYNC_TIMEOUT
}

enum SyncDirection {
  ORDER_PUSH
  STATUS_PULL
  PRODUCT_PULL
  STOCK_PULL
  PRICE_PULL
  CANCEL_PUSH
  VERIFY_IDEMPOTENCY
}

enum SyncLogStatus {
  SUCCESS
  FAILED
  TIMEOUT
  SKIPPED
  NOT_CONFIGURED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum BannerPosition {
  HERO
  PROMO
  STRIP
  FOOTER
}

enum SectionType {
  PRODUCT_GRID
  CATEGORY_GRID
  BANNER_GRID
  TEXT_ONLY
}

enum NotificationType {
  ORDER
  PROMO
  SYSTEM
  STOCK
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  SUPPORT
  CONTENT
}

// Kind of admin-facing alert in the System Log (new order / new message).
enum AdminAlertType {
  ORDER
  MESSAGE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ------------------------------------------------------------
// Customers & addresses
// ------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  name         String
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  addresses       Address[]
  orders          Order[]
  cart            Cart?
  wishlist        Wishlist[]
  reviews         Review[]
  sessions        Session[]
  notifications   Notification[]
  recentlyViewed  RecentlyViewed[]
  couponUsages    CouponUsage[]
  chatThreads     ChatThread[]

  @@index([createdAt])
}

model Address {
  id             String      @id @default(cuid())
  userId         String
  type           AddressType @default(HOME)
  fullName       String
  phone          String
  email          String?
  division       String
  district       String
  area           String
  fullAddress    String
  instructions   String?
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ------------------------------------------------------------
// Catalog
// ------------------------------------------------------------

model Category {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  parentId        String?
  description     String?
  image           String?
  icon            String?
  isActive        Boolean  @default(true)
  position        Int      @default(0)
  showInMenu      Boolean  @default(true)
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([isActive, position])
}

model Brand {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  logo     String?
  isActive Boolean @default(true)

  products Product[]

  @@index([isActive])
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  sku              String        @unique
  // text columns are sized to the limits the API form already enforces
  // (textOrNull in the products routes) — with the Prisma/MySQL default of
  // VARCHAR(191) every longer value died with P2000 "value too long".
  shortDescription String?     @db.VarChar(500)
  description      String?     @db.Text
  brandId          String?
  categoryId       String

  price            Decimal       @db.Decimal(12, 2)
  compareAtPrice   Decimal?      @db.Decimal(12, 2)
  costPrice        Decimal?      @db.Decimal(12, 2)
  discountPercent  Int           @default(0)

  stock            Int           @default(0)
  lowStockThreshold Int          @default(5)

  status           ProductStatus @default(ACTIVE)
  isFeatured       Boolean       @default(false)
  isBestseller     Boolean       @default(false)
  newArrival       Boolean       @default(false)
  isDeal           Boolean       @default(false)

  rating           Float         @default(0)
  ratingCount      Int           @default(0)
  reviewCount      Int           @default(0)
  soldCount        Int           @default(0)
  viewCount        Int           @default(0)

  // Variant dimension values as JSON-encoded string arrays
  // (e.g. '["Black","Gold"]' / '["S","M","L"]') — stored as text so they
  // can be LIKE-filtered by the product filters.
  colors           String?     @db.Text
  sizes            String?     @db.Text

  specifications   Json?
  shippingInfo     String?
  returnInfo       String?

  seoTitle         String?     @db.VarChar(200)
  seoDescription   String?     @db.VarChar(400)

  // External (boss's API) product linkage — mapped once real API is known
  externalProductId String?
  externalSku       String?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  brand    Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category Category         @relation(fields: [categoryId], references: [id])
  images   ProductImage[]
  variants ProductVariant[]
  reviews  Review[]
  logs     InventoryLog[]
  mappings ExternalProductMapping[]
  orderItems OrderItem[]
  cartItems  CartItem[]
  recentlyViewed RecentlyViewed[]
  wishlistEntries Wishlist[]

  @@index([categoryId, status])
  @@index([brandId])
  @@index([status, isFeatured, createdAt])
  @@index([status, isBestseller])
  @@index([status, newArrival])
  @@index([status, isDeal])
  @@index([price])
  @@index([rating])
  @@index([createdAt])
  @@index([name])
  @@index([externalProductId])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

// Durable copy of every uploaded image (public/uploads). Render's free-tier
// disk is ephemeral — each deploy wiped the folder and took live's product
// and category photos with it — so the bytes live in the shared MySQL that
// both the local site and the live site already point at. public/ stays a
// fast static cache; when a file is missing there, /uploads/<dir>/<name>
// falls back to this table (src/app/uploads/[...path]/route.ts).
model StoredImage {
  key       String   @id // "<dir>/<filename>" — identical to the public URL path
  mime      String
  bytes     Bytes // LONGBLOB — uploads are capped at 4MB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  sku       String  @unique
  color     String?
  size      String?
  // Optional per-variant price override; falls back to product price
  price     Decimal? @db.Decimal(12, 2)
  stock     Int     @default(0)
  position  Int     @default(0)

  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  cartItems  CartItem[]
  logs       InventoryLog[]

  @@index([productId])
  @@unique([productId, color, size])
}

model InventoryLog {
  id           String   @id @default(cuid())
  productId    String
  variantId    String?
  change       Int
  balanceAfter Int
  reason       String
  orderId      String?
  actorId      String?
  createdAt    DateTime @default(now())

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([createdAt])
}

// ------------------------------------------------------------
// Cart, wishlist, recently viewed
// ------------------------------------------------------------

model Cart {
  id         String   @id @default(cuid())
  userId     String?  @unique
  sessionId  String?  @unique
  couponCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([sessionId])
}

model CartItem {
  id         String  @id @default(cuid())
  cartId     String
  productId  String
  variantId  String?
  color      String?
  size       String?
  quantity   Int     @default(1)
  addedAt    DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

model Wishlist {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String
  productId String
  viewedAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@index([sessionId, viewedAt])
}

// ------------------------------------------------------------
// Orders & payments
// ------------------------------------------------------------

model Order {
  id            String            @id @default(cuid())
  orderNumber   String            @unique
  // Prevents duplicate orders from double-clicks / refresh / slow network
  idempotencyKey String           @unique
  userId        String?
  guestEmail    String?
  guestPhone    String?

  customerName  String
  customerPhone String
  customerEmail String?

  status        OrderStatus       @default(PENDING)
  paymentMethod PaymentMethod     @default(COD)
  paymentStatus PaymentStatus     @default(UNPAID)

  subtotal      Decimal           @db.Decimal(12, 2)
  discount      Decimal           @default(0) @db.Decimal(12, 2)
  couponCode    String?
  couponId      String?
  deliveryCharge Decimal          @default(0) @db.Decimal(12, 2)
  total         Decimal           @db.Decimal(12, 2)

  // Address snapshot at time of order (JSON)
  address       Json
  instructions  String?
  customerNote  String?
  adminNotes    String?

  // External API forwarding
  externalOrderId    String?        @unique
  externalSyncStatus ExternalSyncStatus @default(NOT_CONFIGURED)
  syncAttempts       Int            @default(0)
  syncStartedAt      DateTime?
  syncedAt           DateTime?
  lastSyncError      String?
  idempotencySent    String?

  trackingNumber String?
  trackingUrl    String?
  trackingData   Json?

  placedAt       DateTime          @default(now())
  confirmedAt    DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  updatedAt      DateTime          @updatedAt

  // Soft delete — the row survives so Admin → Orders → "Delete history" can
  // show it and Restore can bring it back. Every list/count query excludes it.
  deletedAt      DateTime?

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  payments    Payment[]
  syncLogs    ApiSyncLog[]
  mapping     ExternalOrderMapping?
  couponUsage CouponUsage?
  notification Notification[]

  @@index([userId, placedAt])
  @@index([status, placedAt])
  @@index([deletedAt])
  @@index([externalSyncStatus])
  @@index([customerPhone])
  @@index([customerEmail])
  @@index([placedAt])
  @@index([paymentStatus])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String?
  variantId     String?

  // Snapshots so order history never changes if catalog does
  productName   String
  productSlug   String?
  sku           String
  variantLabel  String?
  image         String?
  unitPrice     Decimal  @db.Decimal(12, 2)
  lineDiscount  Decimal  @default(0) @db.Decimal(12, 2)
  quantity      Int
  lineTotal     Decimal  @db.Decimal(12, 2)

  // External reference for this line (mapped when API known)
  externalProductRef String?

  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(UNPAID)
  transactionId String?
  // Sanitized provider payload (never contains secrets)
  providerData  Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([transactionId])
}

// ------------------------------------------------------------
// Coupons
// ------------------------------------------------------------

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique
  type         CouponType
  value        Decimal    @db.Decimal(12, 2)
  minOrder     Decimal    @default(0) @db.Decimal(12, 2)
  maxDiscount  Decimal?   @db.Decimal(12, 2)
  startsAt     DateTime?
  expiresAt    DateTime?
  usageLimit   Int?
  usedCount    Int        @default(0)
  perUserLimit Int        @default(1)
  // Restrict to specific products/categories (empty = all products)
  productIds   Json?
  categoryIds  Json?
  isActive     Boolean    @default(true)
  description  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  usages CouponUsage[]

  @@index([isActive, expiresAt])
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String?
  orderId   String   @unique
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

// ------------------------------------------------------------
// Reviews & notifications
// ------------------------------------------------------------

model Review {
  id         String       @id @default(cuid())
  productId  String
  userId     String
  rating     Int
  title      String?
  comment    String?
  status     ReviewStatus @default(PENDING)
  isVerified Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([status, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  orderId   String?
  type      NotificationType @default(SYSTEM)
  title     String
  body      String?
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

// ------------------------------------------------------------
// Homepage management
// ------------------------------------------------------------

model Banner {
  id          String        @id @default(cuid())
  title       String
  subtitle    String?
  image       String
  mobileImage String?
  link        String?
  buttonText  String?
  position    BannerPosition @default(HERO)
  isActive    Boolean       @default(true)
  positionIndex Int          @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([position, isActive, positionIndex])
}

model HomeSection {
  id          String      @id @default(cuid())
  key         String      @unique
  title       String
  subtitle    String?
  type        SectionType @default(PRODUCT_GRID)
  // For PRODUCT_GRID: which product flags / category to pull from
  source      String      @default("featured")
  itemIds     Json?
  image       String?
  link        String?
  buttonText  String?
  order       Int         @default(0)
  isVisible   Boolean     @default(true)
  updatedAt   DateTime    @updatedAt

  @@index([isVisible, order])
}

// ------------------------------------------------------------
// External commerce integration (boss's e-commerce API)
// ------------------------------------------------------------

model ExternalProductMapping {
  id             String    @id @default(cuid())
  productId      String    @unique
  externalId     String
  externalSku    String?
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([externalId])
}

model ExternalOrderMapping {
  id              String   @id @default(cuid())
  orderId         String   @unique
  externalOrderId String   @unique
  // Sanitized snapshots for auditability (never secrets)
  requestSnapshot Json?
  responseSnapshot Json?
  syncedAt        DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([externalOrderId])
}

model ApiSyncLog {
  id        String        @id @default(cuid())
  orderId   String
  direction SyncDirection
  status    SyncLogStatus
  attempt   Int           @default(1)
  // Sanitized request/response (secrets stripped before storing)
  request   Json?
  response  Json?
  error     String?
  durationMs Int?
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

// ------------------------------------------------------------
// Admin, security & settings
// ------------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(SUPER_ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions    AdminSession[]
  auditLogs   AuditLog[]
  alertsSeen  AdminAlert[]   @relation("AlertSeenBy")

  @@index([isActive])
}

/**
 * Admin System Log entry: fires when a new order or a new contact message
 * arrives, carries the actual content (title + body) so the alert itself
 * says what happened, and records WHO marked it seen and when.
 */
model AdminAlert {
  id        String         @id @default(cuid())
  type      AdminAlertType
  title     String
  body      String?
  link      String?
  seenAt    DateTime?
  seenById  String?
  createdAt DateTime       @default(now())

  seenBy AdminUser? @relation("AlertSeenBy", fields: [seenById], references: [id], onDelete: SetNull)

  @@index([seenAt, createdAt])
  @@index([type, createdAt])
}

/**
 * Fine-grained role permissions (Admin → Roles & Permissions).
 * One row per (role, permission); the full matrix for a role is written on
 * save so an explicitly-revoked permission differs from "never configured"
 * (no rows at all → built-in defaults apply).
 */
model RolePermission {
  id         String    @id @default(cuid())
  role       AdminRole
  permission String
  granted    Boolean   @default(true)
  updatedAt  DateTime  @updatedAt

  @@unique([role, permission])
  @@index([role])
}

model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  adminId   String
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  action     String
  entityType String?
  entityId   String?
  details    Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SiteSetting {
  key       String   @id
  value     Json
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Messages sent from the public contact form (admin inbox).
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

// ------------------------------------------------------------
// Customer support chat — floating widget on the homepage.
// Customers must be logged in to talk; every thread and message is
// visible (and answerable) in Admin → Live Chat.
// ------------------------------------------------------------

enum ChatStatus {
  OPEN
  CLOSED
}

enum ChatSender {
  USER
  ADMIN
  AUTO
}

model ChatThread {
  id            String     @id @default(cuid())
  userId        String
  status        ChatStatus @default(OPEN)
  lastMessageAt DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, createdAt])
  @@index([status, lastMessageAt])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  sender    ChatSender
  body      String     @db.Text
  readAt    DateTime?
  createdAt DateTime   @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// Atomic sequence for generating order numbers like IMAL-2026-000001
model OrderSequence {
  year Int @id
  seq  Int @default(0)
}
